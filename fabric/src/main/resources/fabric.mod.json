{
  "schemaVersion": 1,
  "id": "visualoverhaul",
  "version": "${version}",

  "name": "Visual Overhaul: Legacy",
  "description": "Adds better visuals for certain Minecraft Vanilla Blocks.",
  "authors": [
    "Motschen",
    "TeamMidnightDust",
    "Sythiex"
  ],
  "contact": {
    "homepage": "https://github.com/Sythiex/VisualOverhaul",
    "sources": "https://github.com/Sythiex/VisualOverhaul",
    "issues": "https://github.com/Sythiex/VisualOverhaul/issues"
  },

  "license": "MIT",
  "icon": "assets/visualoverhaul/icon.png",

  "environment": "*",
  "entrypoints": {
    "client": [
      "eu.midnightdust.visualoverhaul.fabric.VisualOverhaulClientFabric"
    ],
    "main": [
      "eu.midnightdust.visualoverhaul.fabric.VisualOverhaulFabric"
    ]
  },

  "depends": {
    "fabric": "*",
    "minecraft": "=1.21.1"
  },

  "mixins": [
    "visualoverhaul.mixins.json",
    "visualoverhaul-fabric.mixins.json"
  ]
}
